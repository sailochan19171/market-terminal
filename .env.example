# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in only what you need.
# `.env` is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Pipeline tuning -------------------------------------------------------
BSE_DB_PATH=data/bse.db
BSE_RAW_DIR=data/raw
BSE_BACKFILL_YEARS=2
BSE_RATE_LIMIT_RPS=2.0          # requests/sec ceiling against BSE
BSE_MAX_RETRIES=4
BSE_TIMEOUT=30

# --- Alerts (all optional; leave blank to disable) -------------------------
ALERT_CHANNELS=                 # comma list: telegram,email,desktop

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Broker (optional; for YOUR OWN holdings + watchlist) ------------------
# One of: zerodha | upstox | angelone   (blank = disabled)
BROKER=

# Zerodha Kite Connect
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# Angel One SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# --- Web app and background jobs ---------------------------------------------
# MARKET_JOBS=off           # run the site without the data worker and daily update
# MARKET_DAILY_HOUR=19      # local time of the weekday end-of-day update
# MARKET_DAILY_MINUTE=30
# FUNDAMENTALS_WORKERS=4    # parallel XBRL downloads
# FUNDAMENTALS_RPS=4        # requests per second to the NSE archive
