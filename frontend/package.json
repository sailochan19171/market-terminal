{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "market": "node --disable-warning=ExperimentalWarning --import tsx src/server/cli.ts",
    "jobs": "node --disable-warning=ExperimentalWarning --import tsx src/server/jobs/runner.ts",
    "e2e:dashboard": "tsx tests/e2e/dashboard.ts",
    "e2e:markets": "tsx tests/e2e/markets.ts",
    "e2e:research": "tsx tests/e2e/research.ts",
    "e2e:agents": "tsx tests/e2e/agents.ts",
    "e2e": "npm run e2e:dashboard && npm run e2e:markets && npm run e2e:research",
    "check:verdict": "tsx scripts/check-verdict.ts",
    "check:language": "tsx scripts/check-language.ts",
    "check:answers": "tsx scripts/check-answers.ts",
    "check:llm": "tsx scripts/check-llm.ts",
    "check:rag": "tsx scripts/check-rag.ts",
    "check:routing": "tsx scripts/check-routing.ts",
    "check:ratios": "tsx scripts/check-ratios.ts",
    "check:agents": "tsx scripts/check-agents.ts",
    "check:reference": "tsx scripts/check-reference.ts",
    "eval:llm": "tsx scripts/eval-llm.ts",
    "test:load": "tsx scripts/load-test.ts",
    "fixtures:save": "tsx scripts/save-fixtures.ts",
    "check": "npm run check:routing && npm run check:verdict && npm run check:language && npm run check:ratios && npm run check:agents",
    "deploy:netlify": "netlify build --offline && netlify deploy --prod --no-build --dir .netlify/static",
    "publish": "node --disable-warning=ExperimentalWarning --import tsx src/server/cli.ts publish",
    "check:orders": "tsx scripts/check-orders.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.9",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "saxes": "^6.0.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.55.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
